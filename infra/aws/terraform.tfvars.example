# Copy to infra/aws/terraform.tfvars (gitignored) and fill in.
# Credentials come from the AWS CLI, not from this file:
#   aws configure          # or: aws sso login --profile your-profile
#   aws sts get-caller-identity

aws_region = "us-east-1"
# aws_profile = "your-profile"

# t3.small is the comfortable default (2 GB RAM). Free-tier alternative:
# instance_type = "t3.micro"

ssh_public_key = "ssh-ed25519 AAAA... you@jobspy-lite"

# Tighten both once you know your public IP:
# ssh_cidrs = ["203.0.113.10/32"]
# app_cidrs = ["203.0.113.10/32"]

app_port = 8000

# After apply, store keys in Secrets Manager (not in this file):
#   aws secretsmanager put-secret-value --secret-id jobspy-lite/env --secret-string '{...}'
# See infra/aws/README.md. The deploy script reads that secret on the instance.
