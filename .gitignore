# Secrets
.env

# Local server backups (contains .env)
backup/

# Data (DB, Excel export, resume)
data/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Editors / OS
.vscode/
.idea/
.DS_Store
.freebuff/
logs.txt

# Terraform state + local vars (state can contain secrets; never commit)
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfvars
infra/*.tfstate
infra/*.tfstate.*
infra/plan.txt
infra/tfplan
infra/.terraform.tfstate.lock.info

# AWS stack keeps its own state (infra/ patterns above are not recursive)
infra/aws/.terraform/
infra/aws/.terraform.lock.hcl
infra/aws/terraform.tfvars
infra/aws/*.tfstate
infra/aws/*.tfstate.*
infra/aws/plan.txt
infra/aws/tfplan
infra/aws/.terraform.tfstate.lock.info
infra/aws/secret.json
