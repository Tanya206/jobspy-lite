# Secrets only. Every other setting lives in config.yaml.

# NVIDIA NIM key. Required when ai.provider is nvidia (the default).
NVIDIA_API_KEY=

# OpenAI key. Required when ai.provider is openai, or when a base URL points at api.openai.com.
# OPENAI_API_KEY=

# Optional rewrite-only key. When unset, the rewrite uses the key for its base URL.
# REWRITE_API_KEY=

# Telegram alerts. Create a bot with @BotFather, message it once, then read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trace export auth. The endpoint itself is tracing.otel_endpoint in config.yaml.
# Langfuse wants Authorization=Basic plus the base64 of public_key:secret_key.
# A raw pk-...:sk-... value is base64-encoded at startup.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>

# Optional. When set, every API call except /health must send X-API-Token.
# JOBSPY_API_TOKEN=
