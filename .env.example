# JobSpy Lite configuration — copy to .env and fill in.

# --- Required: AI provider key (NVIDIA NIM by default) ---
NVIDIA_API_KEY=your_nvidia_api_key
# AI_MODEL=nvidia/nemotron-3-super-120b-a12b
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Required for Telegram notifications (step 5) ---
# Create a bot with @BotFather, then message it once and read your chat id
# via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (All above-threshold jobs are alerted now; messages auto-chunk.)

# --- Scrape defaults (runtime-editable from the UI settings) ---
SITES=linkedin,indeed
SEARCH_TERMS=AI Engineer
LOCATION=Bengaluru
RESULTS_WANTED=5
HOURS_OLD=6
COUNTRY_INDEED=india
LINKEDIN_FETCH_DESCRIPTION=true
IS_REMOTE=false
SCRAPE_COOLDOWN_MINUTES=0.5

# Optional proxies for scraping from datacenter IPs (comma-separated)
# PROXIES=http://user:pass@host:port

# --- Screening defaults (runtime-editable from the UI settings) ---
EXPERIENCE_MIN_YEARS=0
EXPERIENCE_MAX_YEARS=2
SCORE_THRESHOLD=70

# --- Pipeline ---
MAX_WORKERS=4
# AI calls per minute (NVIDIA free tier caps at 40; keep a little headroom)
AI_RATE_LIMIT_PER_MIN=30
# Hours before a scored job is re-scored (0 = never re-score; a new resume
# upload always re-scores everything regardless)
RESCORE_AFTER_HOURS=72

# --- Storage (defaults live under ./data) ---
# JOBSPY_DATA_DIR=./data

# --- API auth ---
# Required when the server is reachable beyond localhost. Leave unset for
# local pytest / Vite. The dashboard stores this in sessionStorage and sends
# it as X-API-Token. GET /health stays open for the Docker healthcheck.
# JOBSPY_API_TOKEN=
